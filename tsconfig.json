{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@jsdesk/core": ["./packages/core/src/index.ts"],
      "@jsdesk/compiler": ["./packages/compiler/src/index.ts"],
      "@jsdesk/cli": ["./packages/cli/src/index.ts"]
    },
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
